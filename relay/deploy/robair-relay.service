# /etc/systemd/system/robair-relay.service — relais RobAir durci (J1 §2.3).
# Utilisateur système dédié, aucun privilège sauf ouvrir le port 443, système de fichiers en lecture seule
# sauf le dossier de données.
[Unit]
Description=RobAir relais aveugle
After=network-online.target
Wants=network-online.target

[Service]
User=robair-relay
Group=robair-relay
ExecStart=/usr/bin/python3 -I /opt/robair-relay/robair_relay.py serve --data-dir /var/lib/robair-relay \
    --cert /etc/robair-relay/tls/fullchain.pem --key /etc/robair-relay/tls/privkey.pem --port 443
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/robair-relay
ReadOnlyPaths=/etc/robair-relay
UMask=0077

[Install]
WantedBy=multi-user.target
