// Base.xcconfig — réglages communs, versionnés.
// NE PAS mettre votre Team ID ici : il va dans config/Signing.local.xcconfig (ignoré par git),
// créé par scripts/setup.sh. Ainsi, changer de Mac ou de compte ne modifie pas le projet.

ROBAIR_BUNDLE_PREFIX = fr.m2.changeme
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Signing.local.xcconfig"
